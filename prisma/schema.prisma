// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`\

// this file is similar to models/User.js, Diagram.js in mongoose
// which helps us to create DB models

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// 1. Users Table (Upgraded for NextAuth)
model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?

  accounts  Account[]
  sessions  Session[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  diagrams Diagram[] // if Diagram gets deleted then it must also delete from here
}

// NextAuth: Stores Google OAuth Tokens
model Account {
  id                       String  @id @default(cuid())
  userId                   String
  type                     String
  provider                 String
  providerAccountId        String
  refresh_token            String? @db.Text
  access_token             String? @db.Text
  expires_at               Int?
  token_type               String?
  scope                    String?
  id_token                 String? @db.Text
  session_state            String?
  refresh_token_expires_in Int?
  user                     User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([provider, providerAccountId])
  @@index([userId])
}

// NextAuth: Manages active browser sessions
model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  expires      DateTime

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

// 2. Diagrams Table (The Project Hub)
model Diagram {
  id        String   @id @default(cuid())
  title     String
  updatedAt DateTime @updatedAt

  // to which user this diagram belongs
  userId String
  // Foreign Key relation back to the User
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  // if a user gets deleted, delete all diagrams which have userId referencing to that user's id

  // A diagram contains many nodes and edges
  nodes DiagramNode[]
  edges DiagramEdge[]
}

// 3. Diagram Nodes Table
model DiagramNode {
  id             String @id // We will save the exact React Flow 'node-12345' ID here
  type           String
  label          String
  x_pos          Float
  y_pos          Float
  node_data_json Json // Stores the hiddenAttributes, primaryKey, etc.

  // Foreign Key relation back to the Diagram
  diagramId String
  diagram   Diagram @relation(fields: [diagramId], references: [id], onDelete: Cascade)
}

// 4. Diagram Edges Table
model DiagramEdge {
  id                 String  @id
  source_node        String
  target_node        String
  type               String
  source_cardinality String?
  target_cardinality String?
  label              String?

  // 🌟 NEW: Track the exact connection ports!
  source_handle String?
  target_handle String?

  diagramId String
  diagram   Diagram @relation(fields: [diagramId], references: [id], onDelete: Cascade)
}
